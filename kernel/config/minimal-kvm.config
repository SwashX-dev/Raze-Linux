# Raze Minimal kernel fragment, applied on top of x86_64_defconfig + kvm_guest.config.
# Target: QEMU/KVM guests (virtio devices). Not for bare metal.
CONFIG_LOCALVERSION="-raze-minimal"
CONFIG_DEFAULT_HOSTNAME="raze"
# Scheduling: same interactive defaults as the generic kernel
CONFIG_HZ_1000=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Early userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_FUSE_FS=y
# virtio (kvm_guest.config enables the core set; make the rest built-in)
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SCSI_VIRTIO=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_INPUT_EVDEV=y
# Containers / Nix sandbox / systemd requirements
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_DMIID=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSWAP=y
# Size / build time
CONFIG_DEBUG_INFO_NONE=y
CONFIG_IKCONFIG=n
CONFIG_KALLSYMS_ALL=n
CONFIG_MODULE_SIG=n
CONFIG_SOUND=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_USB_SUPPORT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# Boot-time cost reductions (measured with Raze Core, see docs/performance/benchmarks.md):
# built-in btrfs pulls in RAID6, whose algorithm benchmark ran ~160 ms at boot.
CONFIG_RAID6_PQ_BENCHMARK=n
# libata probing of the QEMU ATA port took ~90 ms when built in; virtio guests boot
# from virtio-blk, so ATA becomes modular (still available for CD-ROMs).
CONFIG_ATA=m
CONFIG_SATA_AHCI=m
CONFIG_ATA_PIIX=m
CONFIG_NETCONSOLE=n
# Boot-time W+X page-table scan (~45 ms): a debug warning, not a protection.
CONFIG_DEBUG_WX=n
