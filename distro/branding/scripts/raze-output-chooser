#!/bin/sh
# Output chooser for screen sharing (xdg-desktop-portal-wlr): with one monitor, share
# it; with several, click the one to share (slurp).
outs=$(rift msg outputs 2>/dev/null | jq -r '.[].name' 2>/dev/null)
if [ -n "$outs" ] && [ "$(printf '%s\n' "$outs" | wc -l)" -eq 1 ]; then
    printf '%s\n' "$outs"
else
    exec slurp -f %o -or
fi
