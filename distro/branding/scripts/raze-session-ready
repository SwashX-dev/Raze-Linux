#!/bin/sh
# Run by the compositor once its Wayland socket exists: publish the session's display
# variables to the user supervisor and to D-Bus activation, then start the graphical
# session services (r6 user service `graphical-session` and its dependencies).
vars="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE RIFT_SOCKET"
if [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/r6/control.sock" ]; then
    # shellcheck disable=SC2086
    r6 --user import-env $vars > /dev/null
    # shellcheck disable=SC2086
    dbus-update-activation-environment $vars 2> /dev/null
    r6 --user start --no-block graphical-session > /dev/null 2>&1
elif command -v systemctl > /dev/null; then
    # shellcheck disable=SC2086
    dbus-update-activation-environment --systemd $vars 2> /dev/null
    # Without a user supervisor, Rift's session components run as plain children.
    if [ "$XDG_CURRENT_DESKTOP" = rift ]; then
        rift-shell &
        wl-paste --watch cliphist store &
    fi
fi
# Live ISO: open the installer once per session.
raze-session-autostart > /dev/null 2>&1 &
exit 0
